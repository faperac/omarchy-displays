#!/usr/bin/env bash
# omarchy-displays — write ~/.config/hypr/monitors.lua from a monitor arrangement
#
# Bundled with the "Displays Arranger" Omarchy plugin. The bar panel calls
# `--from-native`; the other modes are for standalone use.
#
# Usage:
#   omarchy-displays               Open the standalone Quickshell window
#   omarchy-displays --print       Print the Lua for the CURRENT live layout
#   omarchy-displays --from-native SRC
#                                  Write monitors.lua from native "monitor=" lines.
#                                  SRC is a file, "-" for stdin, or the text itself.
#   omarchy-displays --help        Show this help

set -euo pipefail

MONITORS_LUA="${HOME}/.config/hypr/monitors.lua"
BLOCK_START="-- >>> omarchy-displays managed block (generated) >>>"
BLOCK_END="-- <<< omarchy-displays managed block <<<"
tmpdir=""

SELF="$(realpath "${BASH_SOURCE[0]}")"
QML="$(dirname "$SELF")/../qml/Displays.qml"

die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[36m%s\033[0m\n' "$*" >&2; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

notify() {
  command -v omarchy-notification-send >/dev/null 2>&1 \
    && omarchy-notification-send -u low "omarchy-displays" "$1" >/dev/null 2>&1 || true
}

need_hyprland() {
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || die "Not running under Hyprland."
}

# Read native Hyprland "monitor=" lines on stdin, emit hl.monitor({...}) on stdout.
translate() {
  awk '
    function trim(s){ gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^[ \t]*monitor[ \t]*=/ {
      line = $0
      sub(/^[ \t]*monitor[ \t]*=[ \t]*/, "", line)
      n = split(line, f, /[ \t]*,[ \t]*/)
      name = trim(f[1])
      if (name == "") next

      if (n >= 2 && (tolower(f[2]) == "disable" || tolower(f[2]) == "disabled")) {
        printf "hl.monitor({ output = \"%s\", mode = \"disable\" })\n", name
        next
      }

      mode = (n >= 2 ? trim(f[2]) : "preferred")
      sub(/[Hh][Zz]$/, "", mode)
      sub(/\.0+$/, "", mode)                     # 1920x1080@60.00 -> @60
      pos   = (n >= 3 ? trim(f[3]) : "auto")
      scale = (n >= 4 ? trim(f[4]) : "1")
      sub(/\.0+$/, "", scale)                    # 1.0 -> 1
      if (scale !~ /^[0-9]+(\.[0-9]+)?$/) scale = "\"" scale "\""

      transform = ""; mirror = ""
      for (i = 5; i + 1 <= n; i += 2) {
        k = tolower(trim(f[i])); v = trim(f[i+1])
        if (k == "transform") transform = v
        else if (k == "mirror") mirror = v
      }

      out = sprintf("hl.monitor({ output = \"%s\", mode = \"%s\", position = \"%s\", scale = %s", \
                    name, mode, pos, scale)
      if (transform != "" && transform != "0") out = out sprintf(", transform = %s", transform)
      if (mirror != "")                        out = out sprintf(", mirror = \"%s\"", mirror)
      print out " })"
    }
  '
}

print_current() {
  need_hyprland
  command -v jq >/dev/null 2>&1 || die "jq is required for --print."
  hyprctl -j monitors | jq -r '
    .[] | "monitor=\(.name),\(.width)x\(.height)@\(.refreshRate),\(.x)x\(.y),\(.scale),transform,\(.transform)"
  ' | translate
}

write_block() {
  local generated="$1"
  [ -f "$MONITORS_LUA" ] || die "Not found: $MONITORS_LUA — is this an Omarchy system?"

  local backup="${MONITORS_LUA}.bak.$(date +%s)"
  cp "$MONITORS_LUA" "$backup"
  info "Backup: $backup"

  local tmp="$tmpdir/monitors.lua"
  # drop any previous managed block
  awk -v s="$BLOCK_START" -v e="$BLOCK_END" '
    $0 == s { skip = 1 }
    !skip   { print }
    $0 == e { skip = 0 }
  ' "$MONITORS_LUA" > "$tmp"
  # collapse trailing blank lines
  awk 'NF { for (i = 0; i < hold; i++) print ""; hold = 0; print; next } { hold++ }' "$tmp" > "$tmp.2"
  mv "$tmp.2" "$tmp"

  {
    printf '\n%s\n' "$BLOCK_START"
    printf '%s\n' "-- Generated by omarchy-displays. Re-run it to change the arrangement."
    printf '%s\n' "-- Edits inside this block are overwritten; put custom rules outside it."
    printf '%s\n' "$generated"
    printf '%s\n' "$BLOCK_END"
  } >> "$tmp"

  mv "$tmp" "$MONITORS_LUA"

  if grep -qE '^[[:space:]]*[^-[:space:]].*hl\.monitor\(\{[^}]*output[[:space:]]*=[[:space:]]*""' "$backup"; then
    warn "Note: a catch-all hl.monitor({ output = \"\", ... }) rule is active in monitors.lua."
    warn "      If the new arrangement looks ignored, comment that line out."
  fi

  info "Reloading Hyprland…"
  hyprctl reload >/dev/null
  local errs; errs="$(hyprctl configerrors 2>/dev/null || true)"
  if [ -n "$errs" ] && ! printf '%s' "$errs" | grep -qi "no errors"; then
    warn "hyprctl reported config errors:"
    printf '%s\n' "$errs" >&2
    warn "Restore with:  cp \"$backup\" \"$MONITORS_LUA\" && hyprctl reload"
    exit 1
  fi
  info "Done — arrangement written to $MONITORS_LUA"
}

from_native() {
  local src="${1:-}" content
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT
  if [ "$src" = "-" ] || [ -z "$src" ]; then
    content="$(cat)"
  elif [ -f "$src" ]; then
    content="$(cat "$src")"
  else
    content="$src"
  fi
  local generated
  generated="$(printf '%s\n' "$content" | translate)"
  [ -n "$generated" ] || die "No valid 'monitor=' lines to write."
  write_block "$generated"
  notify "Display arrangement saved to monitors.lua"
}

run_gui() {
  need_hyprland
  command -v quickshell >/dev/null 2>&1 || die "quickshell is not installed."
  [ -f "$QML" ] || die "Standalone UI not found: $QML"
  exec quickshell -p "$QML"
}

main() {
  case "${1:-}" in
    -h|--help)      awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; exit 0 ;;
    --print)        print_current; exit 0 ;;
    --from-native)  shift; from_native "${1:-}"; exit 0 ;;
    "")             run_gui; exit 0 ;;
    *)              die "Unknown option: $1  (try --help)" ;;
  esac
}

main "$@"
